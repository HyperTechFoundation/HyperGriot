# ─────────────────────────────────────────────────────────────
#  HyperGriot configuration — copy to `.env` and fill in values.
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated list of global owner Telegram user IDs (required)
OWNERS=123456789

# Set to 1 to enable verbose request logging
DEBUG=0

# Data directory for the persistent JSON store
DATA_DIR=./data

# Optional: webhooks (leave blank to use long polling)
# WEBHOOK_DOMAIN=
# WEBHOOK_PORT=
# WEBHOOK_PATH=/hypergriot
