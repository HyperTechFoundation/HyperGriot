# HyperGriot Configuration
# Copy this file to .env and fill in the values.

# Required: Your Telegram Bot Token from @BotFather
BOT_TOKEN=

# Optional: Comma-separated Telegram user IDs with global owner privileges
# Without this, no user has owner bypass rights
# OWNERS=123456789,987654321

# Optional: Directory for persistent data storage (default: ./data)
# DATA_DIR=./data

# Optional: Set to 1 for verbose debug logging
# DEBUG=0

# Optional: Webhook configuration (leave unset for long-polling mode)
# WEBHOOK_DOMAIN=example.com
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/hypergriot
# WEBHOOK_SECRET=your-secret-token
